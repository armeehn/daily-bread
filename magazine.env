# magazine.env — who this magazine is. Edit, then run: python3 tools/rebrand.py
# Every value below is the upstream one; change what you like, keep the rest.
# Values are plain text, no quotes needed. See FORKING.md.

# the magazine, as printed on the masthead
TITLE=Daily Bread

# machine name: worker, systemd units, file names
SLUG=daily-bread

# GitHub owner/name
REPO=armeehn/daily-bread

# where the web edition lives
SITE_DOMAIN=db.ripostelabs.xyz

# a second domain the press accepts (set it to SITE_DOMAIN if you have one)
ALT_DOMAIN=ourdailybre.ad

# the on-demand typesetting server (tools/press-server.py), if you run one
PRESS_HOST=press.hq.ripostelabs.xyz

# the line under the masthead
TAGLINE=A Queer Magazine for the Okanagan

# where it is baked
CITY=Kelowna

# the region it serves
REGION=Okanagan

# who pays for the print run, as it appears in the colophon
FUNDER_LEGAL=Riposte Laboratories Inc.

# the funder, short
FUNDER=Riposte Laboratories

# the funder's site
FUNDER_DOMAIN=ripostelabs.xyz

# the merch storefront
SHOP_URL=https://shop.ripostelabs.xyz

# the Shopify store the merch tools talk to
SHOPIFY_SHOP=h23y0x-fd.myshopify.com

# the desk
CONTACT_EMAIL=hello@dailybread.example

# the editor named on the masthead
EDITOR=Sasha Zero

# the address CI commits as
MAINTAINER_EMAIL=sasha@ripostelabs.xyz
