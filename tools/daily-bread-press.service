[Unit]
Description=Daily Bread press — the studio's edition to PDF on demand (press.hq)
Documentation=file:/home/user/daily-bread/tools/press-server.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
# The main checkout. daily-bread-press-update.timer keeps it level with
# origin/main and restarts this unit when tools/ changed.
WorkingDirectory=/home/user/daily-bread
ExecStart=/usr/bin/python3 tools/press-server.py
Environment=PRESS_PORT=8091
Restart=always
RestartSec=5
TimeoutStopSec=20

# A render is a headless Chromium for a couple of seconds on a shared,
# RAM-oversubscribed host; one job at a time is enforced in the server, and it yields.
Nice=5
MemoryMax=2G
TasksMax=64

# Sandbox: the press reads the checkout (tools/press/node_modules included) and
# the Playwright browsers in ~/.cache, and writes only its own build/ (a temp dir
# per request); Chromium's scratch goes to the private /tmp.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/daily-bread/build
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
