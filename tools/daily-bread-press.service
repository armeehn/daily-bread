[Unit]
Description=Daily Bread press — typeset the studio's edition on demand (press.hq)
Documentation=file:/home/user/daily-bread/tools/press-server.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
# The main checkout. daily-bread-press-update.timer keeps it level with
# origin/main and restarts this unit when tools/ changed.
WorkingDirectory=/home/user/daily-bread
ExecStart=/usr/bin/python3 tools/press-server.py
Environment=PRESS_PORT=8091
Restart=always
RestartSec=5
TimeoutStopSec=20

# lualatex is a whole core for several seconds on a shared, RAM-oversubscribed
# host; one typesetting at a time is enforced in the server, and it yields.
Nice=5
MemoryMax=2G
TasksMax=64

# Sandbox: the press reads the checkout, riposte-latex and TeX Live, and writes
# only its own build/ (per-request temp dirs and the per-build font cache).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/daily-bread/build
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
