        <PAGEOBJECT XPOS="138.381102362205" YPOS="5179.78897637795" OwnPage="15" ItemID="620497136" PTYPE="4" WIDTH="356.446488188976" HEIGHT="48.7172598425197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p16 heard pull quote 90" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" copath="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" gXpos="138.381102362205" gYpos="5179.78897637795" gWidth="0" gHeight="0" PSTYLE="Pull quote · Mono" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Pull quote · Mono"/>
                <ITEXT CH="“My GP is great. My GP is also in Vancouver, where I don't live.”"/>
                <trail PARENT="Pull quote · Mono"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="138.381102362205" YPOS="5233.33543307087" OwnPage="15" ItemID="620743728" PTYPE="4" WIDTH="356.446488188976" HEIGHT="48.7172598425197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p16 heard pull quote 91" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" copath="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" gXpos="138.381102362205" gYpos="5233.33543307087" gWidth="0" gHeight="0" PSTYLE="Pull quote · Mono" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Pull quote · Mono"/>
                <ITEXT CH="“The pharmacist figured it out before any doctor did. Shout out Deb.”"/>
                <trail PARENT="Pull quote · Mono"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="138.381102362205" YPOS="5286.91023622047" OwnPage="15" ItemID="620923968" PTYPE="4" WIDTH="356.446488188976" HEIGHT="48.7172598425197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p16 heard pull quote 92" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" copath="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" gXpos="138.381102362205" gYpos="5286.91023622047" gWidth="0" gHeight="0" PSTYLE="Pull quote · Mono" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Pull quote · Mono"/>
                <ITEXT CH="“I got my referral the same month my lease ended. Guess which one moved faster.”"/>
                <trail PARENT="Pull quote · Mono"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="138.381102362205" YPOS="5340.45669291339" OwnPage="15" ItemID="621040432" PTYPE="4" WIDTH="356.446488188976" HEIGHT="48.7172598425197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p16 heard pull quote 93" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" copath="M0 0 L356.446 0 L356.446 48.7173 L0 48.7173 L0 0 Z" gXpos="138.381102362205" gYpos="5340.45669291339" gWidth="0" gHeight="0" PSTYLE="Pull quote · Mono" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
