        <PAGEOBJECT XPOS="553.543307086614" YPOS="4535.69763779528" OwnPage="14" ItemID="91691828" PTYPE="4" WIDTH="365.585385826772" HEIGHT="43.3045984251969" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p15 heard pull quote 91" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L365.585 0 L365.585 43.3046 L0 43.3046 L0 0 Z" copath="M0 0 L365.585 0 L365.585 43.3046 L0 43.3046 L0 0 Z" gXpos="553.543307086614" gYpos="4535.69763779528" gWidth="0" gHeight="0" PSTYLE="Pull quote · Mono" LAYER="3" NEXTITEM="-1" BACKITEM="-1">
